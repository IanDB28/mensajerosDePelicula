import vehiculos.*
import personasMensajeras.*
import paquetes.*
import lugares.*
import empresaDeMensajeria.*

describe "Test de empresa de mensajeria" {
    test "Si contrato a Neo como mensajero está primero en la lista" {
        empresaDeMensajeria.contratarAPersonaMensajera(neo)
        assert.equals(neo, empresaDeMensajeria.primeraPersonaMensajera())
    }

    test "Si despido a Neo la lista queda vacía" {
        empresaDeMensajeria.contratarAPersonaMensajera(neo)
        empresaDeMensajeria.despedirAPersonaMensajera(neo)
        assert.that(empresaDeMensajeria.noTienePersonasEmpleadas())
    }

    test "Si despido a todas las personas mensajeras la lista queda vacía" {
        empresaDeMensajeria.contratarAPersonaMensajera(neo)
        empresaDeMensajeria.contratarAPersonaMensajera(saraConnor)
        empresaDeMensajeria.contratarAPersonaMensajera(jeanGray)
        empresaDeMensajeria.despedirATodasLasPersonasMensajeras()
        assert.that(empresaDeMensajeria.noTienePersonasEmpleadas())
    }

    test "Si tiene 2 personas empleadas la empresa no es grande" {
        empresaDeMensajeria.contratarAPersonaMensajera(neo)
        empresaDeMensajeria.contratarAPersonaMensajera(saraConnor)
        assert.notThat(empresaDeMensajeria.esGrande())
    }

    test "Si tiene al menos 3 personas empleadas la empresa es grande" {
        empresaDeMensajeria.contratarAPersonaMensajera(neo)
        empresaDeMensajeria.contratarAPersonaMensajera(saraConnor)
        empresaDeMensajeria.contratarAPersonaMensajera(jeanGray)
        assert.that(empresaDeMensajeria.esGrande())
    }

    test "El paquete puede ser entregado por el primer empleado de la empresa de mensajería, es decir Neo" {
        empresaDeMensajeria.contratarAPersonaMensajera(neo)
        paquete.marcarComoPago()
        assert.that(paquete.puedeSerEntregadoPor(empresaDeMensajeria.primeraPersonaMensajera()))
    }

    test "Puedo consultar el peso de la ultima persona mensajera empleada, en este caso Jean Gray" {
        empresaDeMensajeria.contratarAPersonaMensajera(neo)
        empresaDeMensajeria.contratarAPersonaMensajera(jeanGray)
        assert.equals(65, empresaDeMensajeria.ultimaPersonaMensajera().peso())
    }
}

describe "Test de los nuevos tipos de paquetes" {
    test "El precio del paquetito es de 0 sin importar su destino" {
        paquete.cambiarDestino(laMatrix)
        assert.equals(0, paquetito.precio())
    }

    test "Cualquier persona mensajera puede mandar un paquetito sin importar su destino" {
        paquete.cambiarDestino(laMatrix)
        assert.that(paquetito.puedeSerEntregadoPor(saraConnor))
    }

    test "Si el paqueton viajero tiene 1 destino su precio es de 100$" {
        paquetonViajero.agregarDestino(puenteDeBrooklyn)
        assert.equals(100, paquetonViajero.precio())
    }
    
    test "Si el paqueton viajero tiene 2 destinos su precio es de 200$" {
        paquetonViajero.agregarDestino(laMatrix)
        paquetonViajero.agregarDestino(puenteDeBrooklyn)
        assert.equals(200, paquetonViajero.precio())
    }

    test "Si el paqueton viajero tiene un destino no está pago por defecto" {
        paquetonViajero.agregarDestino(puenteDeBrooklyn)
        assert.notThat(paquetonViajero.estaPago())
    }
    
    test "Si el paqueton viajero tiene un destino se debe pagar $100 para que esté pago" {
        paquetonViajero.agregarDestino(puenteDeBrooklyn)
        paquetonViajero.pagar(100)
        assert.that(paquetonViajero.estaPago())
    }
    
    test "El paqueton viajero puede pagarse parcialmente" {
        paquetonViajero.agregarDestino(laMatrix)
        paquetonViajero.pagar(50)
        paquetonViajero.pagar(50)
        assert.that(paquetonViajero.estaPago())
    }

    test "Se puede enviar el paqueton viajero si esta totalmente pago" {
        paquetonViajero.agregarDestino(laMatrix)
        paquetonViajero.pagar(150)
        assert.that(paquetonViajero.puedeSerEntregadoPor(neo))
    }

    test "No se puede enviar el paqueton viajero si no esta totalmente pago" {
        paquetonViajero.agregarDestino(laMatrix)
        paquetonViajero.pagar(50)
        assert.notThat(paquetonViajero.puedeSerEntregadoPor(neo))
    }

    test "La persona mensajera debe poder pasar por todos los destinos para entregarlo" {
        paquetonViajero.agregarDestino(puenteDeBrooklyn)
        paquetonViajero.agregarDestino(laMatrix)
        paquetonViajero.pagar(200)
        assert.that(paquetonViajero.puedeSerEntregadoPor(neo))
    }

    test "Si la persona mensajera no puede pasar por uno de sus destinos no puede entregarlo" {
        paquetonViajero.agregarDestino(puenteDeBrooklyn)
        paquetonViajero.agregarDestino(laMatrix)
        paquetonViajero.pagar(200)
        assert.notThat(paquetonViajero.puedeSerEntregadoPor(saraConnor))
    }
}
