import vehiculos.*
import personasMensajeras.*
import paquete.*
import lugares.*
import empresaDeMensajeria.*

describe "Test de empresa de mensajeria" {
    test "Si contrato a Neo como mensajero está primero en la lista" {
        empresaDeMensajeria.contratarAPersonaMensajera(neo)
        assert.equals(neo, empresaDeMensajeria.primeraPersonaMensajera())
    }

    test "Si despido a Neo la lista queda vacía" {
        empresaDeMensajeria.contratarAPersonaMensajera(neo)
        empresaDeMensajeria.despedirAPersonaMensajera(neo)
        assert.that(empresaDeMensajeria.noTienePersonasEmpleadas())
    }

    test "Si despido a todas las personas mensajeras la lista queda vacía" {
        empresaDeMensajeria.contratarAPersonaMensajera(neo)
        empresaDeMensajeria.contratarAPersonaMensajera(saraConnor)
        empresaDeMensajeria.contratarAPersonaMensajera(jeanGray)
        empresaDeMensajeria.despedirATodasLasPersonasMensajeras()
        assert.that(empresaDeMensajeria.noTienePersonasEmpleadas())
    }

    test "Si tiene 2 personas empleadas la empresa no es grande" {
        empresaDeMensajeria.contratarAPersonaMensajera(neo)
        empresaDeMensajeria.contratarAPersonaMensajera(saraConnor)
        assert.notThat(empresaDeMensajeria.esGrande())
    }

    test "Si tiene al menos 3 personas empleadas la empresa es grande" {
        empresaDeMensajeria.contratarAPersonaMensajera(neo)
        empresaDeMensajeria.contratarAPersonaMensajera(saraConnor)
        empresaDeMensajeria.contratarAPersonaMensajera(jeanGray)
        assert.that(empresaDeMensajeria.esGrande())
    }

    test "El paquete puede ser entregado por el primer empleado de la empresa de mensajería, es decir Neo" {
        empresaDeMensajeria.contratarAPersonaMensajera(neo)
        paquete.marcarComoPago()
        assert.that(paquete.puedeSerEntregadoASuDestinoPor(empresaDeMensajeria.primeraPersonaMensajera()))
    }

    test "Puedo consultar el peso de la ultima persona mensajera empleada, en este caso Jean Gray" {
        empresaDeMensajeria.contratarAPersonaMensajera(neo)
        empresaDeMensajeria.contratarAPersonaMensajera(jeanGray)
        assert.equals(65, empresaDeMensajeria.ultimaPersonaMensajera().peso())
    }
}